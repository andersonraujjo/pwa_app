# Copie para .env e ajuste os valores.
# Em produção (ENV=production), SECRET_KEY não pode ficar com o valor padrão.

ENV=development
SECRET_KEY=troque-esta-chave-em-producao-use-valor-longo-e-aleatorio
DATABASE_URL=sqlite:///./data/app.db
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
ALLOWED_ORIGINS=
SEED_ON_START=true